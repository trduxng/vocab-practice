    %% ================= RELATIONSHIPS =================

    %% Controllers -> Services
    AuthController --> AuthService : calls
    AdminController --> AdminService : calls
    UserController --> UserService : calls
    CreatorController --> CreatorService : calls
    CategoriesController --> CategoriesService : calls
    GamificationController --> GamificationService : calls
    LearningPathController --> LearningPathService : calls
    AIController --> AiService : calls

    %% Services -> DB
    AuthService --> DBConnection : queries
    AdminService --> DBConnection : queries
    UserService --> DBConnection : queries
    CreatorService --> DBConnection : queries
    CategoriesService --> DBConnection : queries
    GamificationService --> DBConnection : queries
    LearningPathService --> DBConnection : queries
    AiService --> DBConnection : queries
    ProgressService --> DBConnection : queries
    ReviewService --> DBConnection : queries
    ReportService --> DBConnection : queries

    %% Service -> Service (cross-service dependencies)
    UserService --> GamificationService : awards XP
    AuthService --> GamificationService : awards login XP
    LearningPathService --> GamificationService : reads metrics
    ProgressService --> GamificationService : reads metrics

    %% Middleware applied to Controllers via route definitions
    AuthMiddleware ..> AdminController : protects routes
    AuthMiddleware ..> UserController : protects routes
    AuthMiddleware ..> CreatorController : protects routes
    ValidationMiddleware ..> AuthController : validates request body
    ValidationMiddleware ..> AdminController : validates request body
    ValidationMiddleware ..> UserController : validates request body
    ValidationMiddleware ..> CreatorController : validates request body
    ErrorHandler ..> AuthController : catches errors
    ErrorHandler ..> AdminController : catches errors
    ErrorHandler ..> UserController : catches errors
    ErrorHandler ..> CreatorController : catches errors
    ErrorHandler ..> GamificationController : catches errors
    ErrorHandler ..> LearningPathController : catches errors
    ErrorHandler ..> AIController : catches errors
