classDiagram
    %% ================= BACKEND CLASSES =================
    %% Based on actual backend source code at backend/src/
    %% Controllers -> Services -> DBConnection
    %% Middleware applied via routes to protect/validate controllers

    class DBConnection {
        +ConnectionPool pool
        +sql library
        +getConnection() Promise~ConnectionPool~
        +closePool() void
    }

    %% ================= MIDDLEWARES =================

    class AuthMiddleware {
        +verifyToken(req, res, next) void
        +checkPermission(code) Function
        +checkAnyPermission(codes) Function
        +verifyAdmin(req, res, next) void
    }

    class ValidationMiddleware {
        +validate(schema) Function
        +schemas Object
    }

    class ErrorHandler {
        +handleError(err, req, res, next) void
    }

    class RateLimiter {
        +limiter Function
    }

    class UploadMiddleware {
        +upload MulterInstance
        +upload.array(fieldName, maxCount) Function
    }

