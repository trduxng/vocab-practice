    %% Frontend Connections
    Landing --> AuthContext
    AuthContext --> ApiClient
    UserPages --> UserService
    CreatorPages --> CreatorService
    AdminPages --> AdminService
    LoginPage --> AuthService
    RegisterPage --> AuthService
    UserService --> ApiClient
    AdminService --> ApiClient
    CreatorService --> ApiClient
    AuthService --> ApiClient
    CategoriesService --> ApiClient

    %% Backend Connections
    ApiClient -->|HTTP REST| AuthRoutes
    ApiClient -->|HTTP REST| CategoriesRoutes
    ApiClient -->|HTTP REST| AdminRoutes
    ApiClient -->|HTTP REST| UserRoutes

    AuthRoutes --> verifyToken
    CategoriesRoutes --> verifyToken
    AdminRoutes --> verifyToken
    UserRoutes --> verifyToken
    AdminRoutes --> checkPermission
    Routes --> validate

    verifyToken --> AuthController
    verifyToken --> CategoriesController
    verifyToken --> AdminController
    verifyToken --> UserController
    checkPermission --> AdminController

    AuthController --> AuthServiceBE
    CategoriesController --> CategoriesServiceBE
    AdminController --> AdminServiceBE
    UserController --> UserServiceBE

    AuthServiceBE --> DBConfig
    CategoriesServiceBE --> DBConfig
    AdminServiceBE --> DBConfig
    UserServiceBE --> DBConfig

    errorHandler --> Controllers

    %% Database Connections
    DBConfig -->|mssql pool| TablesRBAC
    DBConfig -->|mssql pool| TablesContent
    DBConfig -->|mssql pool| TablesProgress
    DBConfig -->|mssql pool| TablesMedia
    DBConfig -->|mssql pool| Views
    DBConfig -->|mssql pool| SP

    %% User role routing
    Learner --> Landing
    Learner -->|"/login"| LoginPage
    Learner -->|"/user/*"| UserPages
    Creator -->|"/creator/*"| CreatorPages
    Admin -->|"/admin/*"| AdminPages
