    %% === BACKEND CLASSES ===

    class AuthMiddleware {
        +verifyToken(req, res, next)
        +checkPermission(code)
        +verifyAdmin(req, res, next)
    }

    class ValidationMiddleware {
        +validate(schema)
        +schemas.register
        +schemas.login
        +schemas.createWord
        +schemas.createQuestion
    }

    class ErrorHandler {
        +handleError(err, req, res, next)
    }

    class AuthController {
        +register(req, res, next)
        +login(req, res, next)
    }

    class AdminController {
        +getWords(req, res, next)
        +createWord(req, res, next)
        +updateWord(req, res, next)
        +deleteWord(req, res, next)
        +getQuestionsByWord(req, res, next)
        +createQuestion(req, res, next)
        +getMiniTests(req, res, next)
        +createMiniTest(req, res, next)
        +getStats(req, res, next)
        +getStudents(req, res, next)
        +toggleStudentStatus(req, res, next)
        +getAnalytics(req, res, next)
    }

    class UserController {
        +getFlashcards(req, res, next)
        +submitAnswer(req, res, next)
        +getStats(req, res, next)
        +getMiniTests(req, res, next)
        +getMiniTestDetails(req, res, next)
        +getTestHistory(req, res, next)
        +getTestSessionDetails(req, res, next)
        +updateProfile(req, res, next)
    }

    class AuthService {
        +register(fullName, email, password)
        +login(email, password)
        -hashPassword(password)
        -verifyPassword(password, hash)
        -generateToken(payload)
    }

    class AdminService {
        +getWords(page, limit)
        +createWord(data, adminId)
        +updateWord(id, data)
        +deleteWord(id)
        +getQuestionsByWord(wordId)
        +createQuestion(data, adminId)
        +getMiniTests()
        +createMiniTest(data, adminId)
        +getDashboardStats()
        +getStudents()
        +toggleUserStatus(userId)
        +getAnalyticsData()
    }

    class UserService {
        +getDueFlashcards(userId)
        +submitAnswer(data)
        +getUserStats(userId)
        +getMiniTests()
        +getMiniTestDetails(testId)
        +updateProfile(userId, fullName)
        +getTestHistory(userId)
        +getTestSessionDetails(userId, testId, date)
    }

    class CategoriesService {
        +getPartOfSpeeches()
        +getTopics()
    }

    class DBConnection {
        +ConnectionPool pool
        +sql library
        +getConnection()
        +closePool()
    }

    %% === RELATIONSHIPS ===

    %% Database Entity Relationships
    User "1" --> "*" Role : has
    Role "1" --> "*" RolePermission : has
    Permission "1" --> "*" RolePermission : assigned to
    User "1" --> "*" ExerciseAttempt : makes
    User "1" --> "*" UserWordProgress : has
    User "1" --> "*" UserTopicEnrollment : enrolls
    User "1" --> "*" UserVocabularyNotebook : owns
    User "1" --> "*" MiniTestAttempt : takes
    User "1" --> "*" Notification : receives
    User "1" --> "*" ContentReport : reports
    User "1" --> "*" ContentReviewLog : reviews
    User "1" --> "*" AdminAuditLog : logs
    Word "1" --> "*" ExampleSentence : has
    Word "1" --> "*" Question : tested by
    Word "1" --> "*" UserWordProgress : tracked in
    Word "1" --> "*" UserVocabularyNotebook : saved in
    Topic "1" --> "*" Word : contains
    Topic "1" --> "*" MiniTest : belongs to
    TopicCategory "1" --> "*" Topic : categorizes
    Word "*" --> "*" Topic : belongs to (via WordTopic)
    Question "*" --> "*" MiniTest : part of (via MiniTestItem)
    MiniTest "1" --> "*" MiniTestItem : has
    MiniTest "1" --> "*" MiniTestAttempt : attempted in
    MediaAsset "*" --> "*" Word : illustrates
    MediaAsset "*" --> "*" Question : supports
    ExerciseAttempt "*" --> "1" Question : answers

    %% Backend Relationships
    AuthController --> AuthService : uses
    AdminController --> AdminService : uses
    UserController --> UserService : uses
    CategoriesController --> CategoriesService : uses

    AuthService --> DBConnection : queries
    AdminService --> DBConnection : queries
    UserService --> DBConnection : queries
    CategoriesService --> DBConnection : queries

    AuthMiddleware --> DBConnection : fetches permissions
    AuthMiddleware --> AuthService : verifies tokens

    ValidationMiddleware ..> AuthController : validates request
    ValidationMiddleware ..> AdminController : validates request
    ErrorHandler ..> AuthController : catches errors
    ErrorHandler ..> AdminController : catches errors
    ErrorHandler ..> UserController : catches errors

    %% Inheritance
    AdminController --|> Controller : extends
    UserController --|> Controller : extends
    AuthController --|> Controller : extends
    CategoriesController --|> Controller : extends

    class Controller {
        +sendSuccess(res, data, statusCode)
        +sendError(res, message, statusCode)
    }

    %% Stored Procedure
    class SP_SubmitQuestionAttempt {
        +@UserID BigInt
        +@QuestionID BigInt
        +@SubmittedAnswer NVarchar
        +@ClientTimeZoneOffset NVarchar
        +@AttemptMetadataJson NVarchar
        -compareAnswer()
        -calculateSRS()
        -upsertProgress()
        -insertAttemptLog()
    }

    DBConnection --> SP_SubmitQuestionAttempt : executes
    UserService --> SP_SubmitQuestionAttempt : calls
