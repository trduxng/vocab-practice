*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
dev-server.*.log
server.log

# ==========================================
# TEMP OFFICE FILES
# ==========================================
~$*.docx
~$*.doc
.$*.docx
.$*.doc

# ==========================================
