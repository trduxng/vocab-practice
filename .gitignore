.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# BUILD OUTPUTS
# ==========================================
.next/
out/
dist/
build/
*.tsbuildinfo
coverage/

# ==========================================
